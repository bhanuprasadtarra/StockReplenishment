@* Horizontal nav rendered inside the top app bar (there's no sidebar to put it in
   anymore). Color="Color.Inherit" picks up the app bar's white-on-dark-blue text
   automatically, so no custom CSS is needed here like the old sidebar version had.

   Nothing shows until a role is picked - checking CurrentRole directly rather than
   GetRole(), since GetRole() falls back to the string "None" which isn't null/empty.
   "New Request" is Worker-only: Reviewers only ever act on requests someone else made. *@
@if (AppState.CurrentRole is not null)
{
    <MudButton Href="requests" Color="Color.Inherit" Class="mx-1">Requests</MudButton>

    @if (AppState.IsWorker())
    {
        <MudButton Href="requests/create" Color="Color.Inherit" Class="mx-1">New Request</MudButton>
    }
}
